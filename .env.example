# CRM MongoDB (supplier states)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/fiesta_crm

# Fiesta site MongoDB (push-to-fiesta)
FIESTA_MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/fiesta

# Copy scraped images into Fiesta public folder on push
FIESTA_PUBLIC_IMAGES_DIR=C:\path\to\fiesta-nextjs\public\images\vendors

# Public URL of this scraping dashboard (fallback for relative media paths)
SCRAPING_PUBLIC_URL=https://fiesta-sapakim.vercel.app

# Cloudinary (optional — uploads images to permanent CDN on push)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email notifications (optional)
EMAIL_USER=
EMAIL_PASS=
EMAIL_TO=
